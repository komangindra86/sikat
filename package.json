{
  "name": "sikat-assets",
  "private": true,
  "description": "Tooling build aset frontend SIKAT (hanya untuk development; produksi tidak membutuhkan Node).",
  "scripts": {
    "build:css": "tailwindcss -i ./web/tailwind.css -o ./static/css/app.css --minify",
    "watch:css": "tailwindcss -i ./web/tailwind.css -o ./static/css/app.css --watch",
    "vendor:js": "node -e \"require('fs').copyFileSync('node_modules/htmx.org/dist/htmx.min.js','static/js/htmx.min.js')\"",
    "vendor:fonts": "node -e \"const f=require('fs');const s='node_modules/@fontsource-variable/inter/';f.copyFileSync(s+'files/inter-latin-wght-normal.woff2','static/fonts/inter-latin.woff2');f.copyFileSync(s+'files/inter-latin-ext-wght-normal.woff2','static/fonts/inter-latin-ext.woff2');f.copyFileSync(s+'LICENSE','static/fonts/Inter-LICENSE.txt')\""
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@tailwindcss/cli": "4.3.5",
    "htmx.org": "2.0.11",
    "tailwindcss": "4.3.5"
  }
}
