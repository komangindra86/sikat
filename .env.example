# Salin menjadi .env lalu sesuaikan. Jangan commit file .env.
# development | production
SIKAT_ENV=development
# Alamat listen aplikasi (di produksi: 127.0.0.1:8080 di belakang Nginx)
SIKAT_ADDR=127.0.0.1:8080
# URL publik aplikasi. Produksi WAJIB https:// (cookie Secure + HSTS aktif otomatis)
SIKAT_BASE_URL=http://localhost:8080
# DSN MySQL tanpa parameter; parameter wajib (UTC, parseTime, sql_mode) ditambahkan aplikasi
SIKAT_DB_DSN=sikat:ganti-password@tcp(127.0.0.1:3306)/sikat
# true hanya bila aplikasi di belakang reverse proxy tepercaya (Nginx) di host yang sama
SIKAT_TRUST_PROXY_HEADERS=false
# debug | info | warn | error
SIKAT_LOG_LEVEL=info
# Umur session (jam) dan batas tidak aktif (menit)
SIKAT_SESSION_LIFETIME_HOURS=12
SIKAT_SESSION_IDLE_MINUTES=120
# Folder data runtime (foto lampiran). Di produksi mis. /var/lib/sikat
SIKAT_STORAGE_DIR=storage
