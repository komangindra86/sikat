# Salin menjadi .env lalu sesuaikan. Jangan commit file .env.
# development | production
SIKAT_ENV=development
# Alamat listen aplikasi (di produksi: 127.0.0.1:8080 di belakang Nginx)
SIKAT_ADDR=127.0.0.1:8080
# URL publik aplikasi. Produksi WAJIB https:// (cookie Secure + HSTS aktif otomatis)
SIKAT_BASE_URL=http://localhost:8080
# DSN MySQL tanpa parameter; parameter wajib (UTC, parseTime, sql_mode) ditambahkan aplikasi
SIKAT_DB_DSN=sikat:ganti-password@tcp(127.0.0.1:3306)/sikat
# true hanya bila aplikasi di belakang reverse proxy tepercaya (Nginx) di host yang sama
SIKAT_TRUST_PROXY_HEADERS=false
# debug | info | warn | error
SIKAT_LOG_LEVEL=info
# Umur session (jam) dan batas tidak aktif (menit)
SIKAT_SESSION_LIFETIME_HOURS=12
SIKAT_SESSION_IDLE_MINUTES=120
# Folder data runtime (foto lampiran). Di produksi mis. /var/lib/sikat
SIKAT_STORAGE_DIR=storage
# Web Push (VAPID) — opsional. Buat dengan: sikat vapid-keys
# Kosong = push nonaktif (notifikasi tetap ada di inbox aplikasi)
SIKAT_VAPID_PUBLIC_KEY=
SIKAT_VAPID_PRIVATE_KEY=
# Kontak pengelola untuk push service: mailto:alamat atau URL https://
SIKAT_VAPID_SUBJECT=
# Backup database harian (mysqldump → gzip) & uji restore
SIKAT_BACKUP_ENABLED=true
# Folder backup (di luar folder web). Produksi: /var/backups/sikat. Default: <SIKAT_STORAGE_DIR>/backups
SIKAT_BACKUP_DIR=
# Jam backup harian (WITA, 0-23) dan lama penyimpanan file (hari)
SIKAT_BACKUP_HOUR=2
SIKAT_BACKUP_KEEP_DAYS=14
# Lokasi biner mysqldump & mysql bila tidak ada di PATH
SIKAT_MYSQLDUMP=mysqldump
SIKAT_MYSQL=mysql
# API pegawai SIMRS (sama dengan aplikasi CSSD): saran nama pelapor saat petugas
# mencatat tiket. Kosong = tanpa saran, nama pelapor diisi bebas. Token & cookie rahasia.
SIKAT_SIMRS_PEGAWAI_URL=
SIKAT_SIMRS_TOKEN=
SIKAT_SIMRS_COOKIE=
SIKAT_SIMRS_TIMEOUT_SECONDS=30
